.hero {
  position: relative;
  width: 100%;
  height: 100vh; height: 100svh;
  height: 100svh;
  min-height: 0;
  overflow: hidden;
  background: var(--bg);
  color: #F6FCFF;
  isolation: isolate;
}

.hero__media { position: absolute; inset: 0; z-index: 1; }
.hero__canvas { width: 100%; height: 100%; display: block; }

.hero__vignette {
  position: absolute; inset: 0; pointer-events: none;
  background: var(--hero-vignette);
}

.hero__scrim {
  position: absolute; inset: 0; pointer-events: none;
  background:
    linear-gradient(to top,
      rgba(5,6,7,0.96) 0%,
      rgba(5,6,7,0.55) 14%,
      rgba(5,6,7,0.06) 38%,
      rgba(5,6,7,0) 55%),
    linear-gradient(to bottom,
      rgba(5,6,7,0.55) 0%,
      rgba(5,6,7,0) 16%);
}

/* Monolith: centered 480px column */
.hero__copy {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: clamp(80px, 14vh, 220px);
  width: min(480px, calc(100% - 2 * var(--gutter)));
  z-index: 2;
  display: grid;
  text-align: left;
  pointer-events: none;
}

.hero__chapter { grid-area: 1 / 1; will-change: opacity, transform; }

.hero__eyebrow {
  display: inline-block;
  margin-bottom: 22px;
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.34em;
  text-transform: uppercase;
  color: rgba(246,252,255,0.55);
}

.hero__headline {
  font-size: clamp(2rem, 4.4vw, 4rem);
  line-height: 1.02;
  letter-spacing: -0.035em;
  font-weight: 500;
  text-transform: uppercase;
  text-wrap: balance;
  margin: 0;
  text-shadow: var(--hero-text-shadow);
}

.hero__headline em {
  font-family: Georgia, 'Times New Roman', serif;
  font-style: italic;
  font-weight: 400;
  letter-spacing: -0.02em;
  text-transform: none;
}

.hero__support {
  margin-top: clamp(14px, 1.8vh, 22px);
  max-width: 42ch;
  font-size: clamp(0.9rem, 1vw, 1.05rem);
  line-height: 1.6;
  color: rgba(246,252,255,0.72);
  text-shadow: var(--hero-text-shadow-sm);
}

.hero__hud {
  position: absolute;
  left: var(--gutter);
  right: var(--gutter);
  bottom: clamp(24px, 3.6vh, 44px);
  z-index: 3;
  display: grid;
  grid-template-columns: auto minmax(80px, 1fr) auto;
  align-items: center;
  gap: clamp(16px, 2vw, 32px);
  pointer-events: none;
}
.hero__hud > * { pointer-events: auto; }

.hero__meta {
  display: flex; align-items: baseline; gap: 4px;
  font-family: var(--font-mono);
  font-variant-numeric: tabular-nums;
  letter-spacing: 0.14em;
}
.hero__counter { font-size: 0.82rem; color: rgba(246,252,255,0.92); }
.hero__counter-total { font-size: 0.68rem; color: rgba(246,252,255,0.38); }

.hero__progress {
  position: relative; height: 1px;
  background: rgba(246,252,255,0.14); overflow: hidden;
}
.hero__progress-fill {
  display: block; height: 100%; width: 100%;
  background: linear-gradient(90deg, #E8A33D, #F4C777);
  transform: scaleX(0); transform-origin: left center;
  will-change: transform;
}

.hero__replay {
  display: inline-flex; align-items: center; gap: 10px;
  height: 44px; padding: 0 22px;
  background: rgba(10,12,11,0.55);
  border: 1px solid rgba(246,252,255,0.42);
  border-radius: 999px;
  color: #F6FCFF;
  font-family: var(--font-mono);
  font-size: 0.68rem; letter-spacing: 0.22em; text-transform: uppercase;
  backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
  cursor: pointer;
  opacity: 0; transform: translateY(12px);
  transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
}
.hero__replay:hover { background: var(--accent); border-color: var(--accent); color: var(--bg-deep); }
.hero__replay svg { transition: transform 0.5s cubic-bezier(0.16,1,0.3,1); }
.hero__replay:hover svg { transform: rotate(-180deg); }

@media (max-width: 767px) {
  .hero__copy { width: calc(100% - 2 * var(--gutter)); }
  .hero__headline { font-size: clamp(1.9rem, 8vw, 2.7rem); }
  .hero__hud {
    grid-template-columns: 1fr;
    gap: 10px;
    padding-bottom: 20px;
  }
  .hero__meta { justify-content: flex-start; }
  .hero__replay { grid-column: 1; justify-self: start; }
  .hero__progress { display: none; }
  .hero__replay { height: 40px; padding: 0 16px; font-size: 0.62rem; }
}
/* ---- Video-based hero (replaced canvas sequence) ---- */
video.hero__canvas {
  object-fit: cover;
  width: 100%;
  height: 100%;
  display: block;
  background: #000;
}


/* ============================================================
   HERO — theme-aware variables
   ============================================================ */
:root,
[data-theme='dark'] {
  --hero-vignette:      radial-gradient(120% 90% at 50% 45%, rgba(0,0,0,0) 42%, rgba(0,0,0,0.62) 100%);
  --hero-scrim:         linear-gradient(180deg, rgba(3,5,7,0.30) 0%, rgba(3,5,7,0.10) 30%, rgba(3,5,7,0.75) 100%);
  --hero-text-shadow:   0 3px 30px rgba(0,0,0,0.5);
  --hero-text-shadow-sm:0 2px 14px rgba(0,0,0,0.45);
  --hero-headline:      #F6F3EC;
  --hero-meta:          rgba(246,243,236,0.7);
}
[data-theme='light'] {
  --hero-vignette:      radial-gradient(120% 90% at 50% 45%, rgba(20,17,12,0) 50%, rgba(20,17,12,0.35) 100%);
  --hero-scrim:         linear-gradient(180deg, rgba(250,247,240,0.30) 0%, rgba(250,247,240,0.05) 30%, rgba(20,17,12,0.30) 100%);
  --hero-text-shadow:   0 2px 20px rgba(255,255,255,0.5);
  --hero-text-shadow-sm:0 1px 10px rgba(255,255,255,0.4);
  --hero-headline:      #14110C;
  --hero-meta:          rgba(20,17,12,0.75);
}

/* Apply variables to hero elements */
.hero__headline { color: var(--hero-headline); text-shadow: var(--hero-text-shadow); }
.hero__eyebrow, .hero__counter, .hero__counter-total { color: var(--hero-meta); }
.hero__support { color: var(--hero-meta); text-shadow: var(--hero-text-shadow-sm); }
.hero__replay { border-color: var(--line-strong); color: var(--ink); background: var(--bg-glass); backdrop-filter: blur(10px); }


