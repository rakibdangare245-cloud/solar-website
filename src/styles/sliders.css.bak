/* Sliders — solutions + testimonials */
.solutions {
  position: relative;
  padding: var(--section-y) 0;
  background: var(--bg);
  border-top: 1px solid var(--line);
  overflow: hidden;
}

.solutions__head { max-width: 720px; margin-bottom: clamp(40px, 6vh, 72px); }
.solutions__eyebrow { display: block; font-size: 0.68rem; letter-spacing: 0.34em; text-transform: uppercase; color: var(--ink-faint); }
.solutions__title { margin-top: 16px; font-size: clamp(2rem, 4.2vw, 3.6rem); line-height: 1.02; letter-spacing: -0.035em; font-weight: 500; text-transform: uppercase; }
.solutions__lede { margin-top: 18px; max-width: 46ch; font-size: 1rem; line-height: 1.65; color: var(--ink-dim); }

.solutions__slider { padding: 0 var(--gutter) 60px; }
.solutions__slider .swiper { overflow: visible; padding: 24px 0 80px; }
.solutions__slider .swiper-slide { height: auto; }

.solution-card {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 340px;
  padding: 34px 30px 30px;
  border: 1px solid var(--line);
  background: linear-gradient(180deg, rgba(255,255,255,0.015), rgba(255,255,255,0));
  border-radius: 4px;
  transition: border-color 0.4s ease, transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), background 0.4s ease;
}
.solution-card:hover { border-color: var(--line-strong); background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0)); }
.solution-card__index { font-size: 0.68rem; letter-spacing: 0.3em; color: var(--ink-faint); font-variant-numeric: tabular-nums; }
.solution-card__title { margin-top: 34px; font-size: clamp(1.35rem, 2vw, 1.75rem); line-height: 1.08; letter-spacing: -0.02em; font-weight: 500; text-transform: uppercase; }
.solution-card__summary { margin-top: 14px; font-size: 0.94rem; line-height: 1.6; color: var(--ink-dim); }
.solution-card__bullets { margin-top: 22px; display: flex; flex-direction: column; gap: 8px; }
.solution-card__bullets li { position: relative; padding-left: 18px; font-size: 0.82rem; color: var(--ink-dim); }
.solution-card__bullets li::before {
  content: ''; position: absolute; left: 0; top: 0.65em;
  width: 8px; height: 1px; background: var(--accent);
}
.solution-card__arrow {
  margin-top: auto; padding-top: 26px;
  font-size: 0.72rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--ink-faint);
  transition: color 0.4s ease, transform 0.4s ease;
}
.solution-card:hover .solution-card__arrow { color: var(--accent); transform: translateX(6px); }

.solutions .swiper-pagination { bottom: 12px !important; }
.solutions .swiper-pagination-bullet {
  width: 22px; height: 1px; border-radius: 0;
  background: var(--line-strong); opacity: 1; margin: 0 4px !important;
  transition: background 0.3s ease;
}
.solutions .swiper-pagination-bullet-active { background: var(--accent); }

/* Testimonials */
.testimonials {
  position: relative;
  padding: var(--section-y) 0;
  background: var(--bg-raised);
  border-top: 1px solid var(--line);
  overflow: hidden;
}
.testimonials__head { max-width: 720px; margin-bottom: clamp(40px, 6vh, 64px); }
.testimonials__eyebrow { display: block; font-size: 0.68rem; letter-spacing: 0.34em; text-transform: uppercase; color: var(--ink-faint); }
.testimonials__title { margin-top: 16px; font-size: clamp(1.8rem, 3.6vw, 3rem); line-height: 1.05; letter-spacing: -0.03em; font-weight: 500; text-transform: uppercase; }

.testimonials__slider { position: relative; padding: 0 var(--gutter); }
.testimonials__slider .swiper { padding: 8px 0 80px; }
.testimonial { max-width: 900px; }
.testimonial__quote {
  font-size: clamp(1.4rem, 3vw, 2.4rem);
  line-height: 1.24;
  letter-spacing: -0.02em;
  font-weight: 400;
  color: var(--ink);
}
.testimonial__caption { display: flex; align-items: baseline; gap: 16px; margin-top: 28px; }
.testimonial__author { font-size: 0.8rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--ink); }
.testimonial__role { font-size: 0.78rem; color: var(--ink-faint); letter-spacing: 0.06em; }

.testimonials .swiper-button-prev,
.testimonials .swiper-button-next {
  color: var(--ink-dim); width: 44px; height: 44px;
  border: 1px solid var(--line-strong); border-radius: 999px;
  top: auto; bottom: 24px; margin-top: 0;
  transition: color 0.3s ease, border-color 0.3s ease;
}
.testimonials .swiper-button-prev { left: auto; right: 72px; }
.testimonials .swiper-button-next { right: 0; }
.testimonials .swiper-button-prev:hover,
.testimonials .swiper-button-next:hover { color: var(--accent); border-color: var(--accent); }
.testimonials .swiper-button-prev::after,
.testimonials .swiper-button-next::after { font-size: 12px; }
.testimonials .swiper-pagination { bottom: 24px !important; text-align: left; padding-left: 2px; }
.testimonials .swiper-pagination-bullet {
  width: 22px; height: 1px; border-radius: 0;
  background: var(--line-strong); opacity: 1;
  transition: background 0.3s ease;
}
.testimonials .swiper-pagination-bullet-active { background: var(--accent); }
