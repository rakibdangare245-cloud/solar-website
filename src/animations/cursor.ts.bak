import gsap from 'gsap';

type CursorState = 'default' | 'link' | 'cta' | 'drag' | 'view';

const STATIC_TWEEN = { duration: 0.18, ease: 'power3.out' } as const;
const TRAIL_TWEEN = { duration: 0.55, ease: 'power3.out' } as const;

export function createCustomCursor(): () => void {
  const root = document.createElement('div');
  root.className = 'cursor';
  root.dataset.state = 'default';
  root.innerHTML =
    '<div class="cursor__dot"><span></span></div>' +
    '<div class="cursor__ring"><span></span></div>' +
    '<div class="cursor__label"></div>';

  document.body.appendChild(root);
  document.documentElement.classList.add('has-custom-cursor');

  const dot = root.querySelector<HTMLElement>('.cursor__dot');
  const ring = root.querySelector<HTMLElement>('.cursor__ring');
  const label = root.querySelector<HTMLElement>('.cursor__label');

  if (!dot || !ring || !label) {
    root.remove();
    document.documentElement.classList.remove('has-custom-cursor');
    return () => undefined;
  }

  gsap.set([dot, ring, label], { xPercent: -50, yPercent: -50, opacity: 0 });

  const dotX = gsap.quickTo(dot, 'x', STATIC_TWEEN);
  const dotY = gsap.quickTo(dot, 'y', STATIC_TWEEN);
  const ringX = gsap.quickTo(ring, 'x', TRAIL_TWEEN);
  const ringY = gsap.quickTo(ring, 'y', TRAIL_TWEEN);
  const labelX = gsap.quickTo(label, 'x', TRAIL_TWEEN);
  const labelY = gsap.quickTo(label, 'y', TRAIL_TWEEN);

  let visible = false;
  const show = () => {
    if (visible) return;
    visible = true;
    gsap.to([dot, ring, label], { opacity: 1, duration: 0.25, ease: 'power2.out' });
  };
  const hide = () => {
    if (!visible) return;
    visible = false;
    gsap.to([dot, ring, label], { opacity: 0, duration: 0.2, ease: 'power2.out' });
  };

  const onPointerMove = (event: PointerEvent) => {
    show();
    dotX(event.clientX);
    dotY(event.clientY);
    ringX(event.clientX);
    ringY(event.clientY);
    labelX(event.clientX);
    labelY(event.clientY);
  };

  const resolveState = (target: EventTarget | null): { state: CursorState; text: string } => {
    if (!(target instanceof Element)) return { state: 'default', text: '' };
    const owner = target.closest<HTMLElement>('[data-cursor]');
    if (!owner) return { state: 'default', text: '' };
    const value = owner.dataset.cursor;
    const text = owner.dataset.cursorLabel ?? '';
    if (value === 'cta' || value === 'link' || value === 'drag' || value === 'view') {
      return { state: value, text };
    }
    return { state: 'default', text: '' };
  };

  const onPointerOver = (event: PointerEvent) => {
    const { state, text } = resolveState(event.target);
    root.dataset.state = state;
    label.textContent = text;
  };

  const onPointerLeaveDocument = (event: PointerEvent) => {
    if (event.relatedTarget === null) hide();
  };

  const onPointerDown = () => gsap.to(root, { scale: 0.92, duration: 0.15, ease: 'power2.out' });
  const onPointerUp = () => gsap.to(root, { scale: 1, duration: 0.3, ease: 'power3.out' });

  window.addEventListener('pointermove', onPointerMove, { passive: true });
  window.addEventListener('pointerover', onPointerOver, { passive: true });
  window.addEventListener('pointerout', onPointerLeaveDocument, { passive: true });
  window.addEventListener('pointerdown', onPointerDown, { passive: true });
  window.addEventListener('pointerup', onPointerUp, { passive: true });
  window.addEventListener('blur', hide);

  return () => {
    window.removeEventListener('pointermove', onPointerMove);
    window.removeEventListener('pointerover', onPointerOver);
    window.removeEventListener('pointerout', onPointerLeaveDocument);
    window.removeEventListener('pointerdown', onPointerDown);
    window.removeEventListener('pointerup', onPointerUp);
    window.removeEventListener('blur', hide);
    document.documentElement.classList.remove('has-custom-cursor');
    gsap.killTweensOf([dot, ring, label, root]);
    root.remove();
  };
}
