.nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 200;
  transition: background-color 0.5s ease, backdrop-filter 0.5s ease, border-color 0.5s ease;
  border-bottom: 1px solid transparent;
}
.nav[data-scrolled='true'] {
  background: rgba(8, 10, 9, 0.72);
  backdrop-filter: blur(14px) saturate(120%);
  -webkit-backdrop-filter: blur(14px) saturate(120%);
  border-bottom-color: var(--line);
}
.nav__inner {
  display: flex; align-items: center; justify-content: space-between;
  gap: 24px; height: 76px;
  max-width: 1440px; margin: 0 auto; padding: 0 var(--gutter);
}
.nav__brand { font-size: 0.76rem; letter-spacing: 0.32em; text-transform: uppercase; font-weight: 500; white-space: nowrap; }
.nav__links { display: flex; align-items: center; gap: clamp(16px, 2.2vw, 32px); }
.nav__link { position: relative; font-size: 0.78rem; letter-spacing: 0.06em; color: var(--ink-dim); transition: color 0.3s ease; }
.nav__link::after {
  content: ''; position: absolute; left: 0; bottom: -6px; width: 100%; height: 1px;
  background: currentColor; transform: scaleX(0); transform-origin: left center;
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}
.nav__link:hover { color: var(--ink); }
.nav__link:hover::after { transform: scaleX(1); }
.nav__actions { display: flex; align-items: center; gap: 14px; }
.nav__cta {
  height: 44px; padding: 0 22px;
  border: 1px solid var(--line-strong); border-radius: 999px;
  font-size: 0.76rem; letter-spacing: 0.1em; text-transform: uppercase;
  transition: background-color 0.35s ease, color 0.35s ease, border-color 0.35s ease;
  will-change: transform;
}
.nav__cta:hover { background: var(--ink); color: var(--bg-deep); border-color: var(--ink); }
.nav__toggle {
  width: 44px;
  height: 44px; border: 1px solid var(--line); border-radius: 999px; align-items: center;
}
.nav__toggle span { display: block; width: 14px; height: 1px; background: var(--ink); }
.nav__panel {
  position: fixed; inset: 0; z-index: 190; display: none; flex-direction: column;
  justify-content: center; gap: 6px; padding: 0 var(--gutter);
  background: rgba(7, 9, 8, 0.97); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
}
.nav__panel-link { padding: 10px 0; font-size: clamp(1.6rem, 8vw, 2.4rem); letter-spacing: -0.02em; text-transform: uppercase; border-bottom: 1px solid var(--line); }
.nav__panel-cta { margin-top: 26px; align-self: flex-start; padding: 14px 30px; border: 1px solid var(--line-strong); border-radius: 999px; font-size: 0.8rem; letter-spacing: 0.14em; text-transform: uppercase; }
@media (max-width: 1023px) {
  .nav__links { display: none; }
  .nav__cta { display: none; }
  .nav__toggle { display: flex; }
}

/* ============================================================
   NAV DRAWER (mobile) — polished
   ============================================================ */
@media (max-width: 1023px) {
  .nav__inner { height: 68px; }
  .nav__links { display: none; }
  .nav__cta   { display: none; }
  .nav__toggle { display: inline-flex; align-items: center; justify-content: center; }

  .nav__panel {
    position: fixed;
    inset: 0;
    z-index: 190;
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    padding: 0 var(--gutter);
    background: var(--bg-glass);
    backdrop-filter: blur(24px) saturate(140%);
    -webkit-backdrop-filter: blur(24px) saturate(140%);
  }
  .nav__panel.is-open { display: flex; }
  .nav__panel-link {
    padding: 16px 0;
    font-size: clamp(1.4rem, 6vw, 2rem);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    border-bottom: 1px solid var(--line);
    transition: color .3s var(--ease), padding-left .3s var(--ease);
  }
  .nav__panel-link:hover { color: var(--accent); padding-left: 12px; }
  .nav__panel-cta {
    margin-top: 26px;
    align-self: flex-start;
    padding: 14px 30px;
    background: var(--ink);
    color: var(--bg-deep);
    border-radius: 999px;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 500;
  }
}

@media (max-width: 480px) {
  .nav__brand { font-size: 0.68rem; letter-spacing: 0.24em; }
}
